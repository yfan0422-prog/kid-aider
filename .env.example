# Kid-Aider 环境变量配置模板
# 复制为 .env 并填入实际值（.env 已在 .gitignore 中忽略）

# ========== 数据目录（生产环境必设）==========
# 本地开发无需设置，默认使用项目内 data/ 目录
DATA_DIR=/opt/kid-aider-data

# ========== 服务配置 ==========
HOST=127.0.0.1
PORT=3000

# ========== AI 模型 API ==========
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=sk-ant-xxx

# ========== 应用配置 ==========
NODE_ENV=production
